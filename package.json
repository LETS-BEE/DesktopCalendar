{
  "name": "desktop-calendar",
  "productName": "desktop-calendar",
  "private": true,
  "version": "3.1.3",
  "author": "LETBBI & tbvjaos510 <ghghdirk12@gmail.com, tbvjaos510@naver.com>",
  "description": "electron-vue으로 제작한 desktop calendar",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vite serve",
    "deps:install": "corepack pnpm install",
    "deps:install:frozen": "corepack pnpm install --frozen-lockfile",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vue-tsc --noEmit && vite build",
    "native:build": "node-gyp rebuild --directory electron-disable-minimize",
    "native:rebuild": "electron-rebuild --force --which-module electron-disable-minimize",
    "native:smoke": "electron tests/native-smoke.cjs",
    "package": "vue-tsc --noEmit && vite build && electron-builder",
    "package:dir": "vue-tsc --noEmit && vite build && electron-builder --dir --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.6.0",
    "@fullcalendar/vue3": "^7.0.2",
    "@toast-ui/editor": "^3.2.2",
    "@vuepic/vue-datepicker": "^14.0.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.19",
    "electron-disable-minimize": "workspace:*",
    "electron-store": "^11.0.2",
    "google-auth-library": "^10.6.1",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.2",
    "temporal-polyfill": "^1.0.1",
    "uikit": "^3.25.13",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/uikit": "^3.23.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.2",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "node-gyp": "13.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.5"
  },
  "main": "dist-electron/main.js"
}
